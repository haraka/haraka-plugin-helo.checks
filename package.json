{
  "name": "haraka-plugin-helo.checks",
  "version": "1.1.1",
  "description": "Haraka plugin checks the HELO string.",
  "main": "index.js",
  "files": [
    "CHANGELOG.md",
    "config"
  ],
  "scripts": {
    "format": "npm run prettier:fix && npm run lint:fix",
    "lint": "npx eslint *.js test",
    "lint:fix": "npx eslint *.js test --fix",
    "prettier": "npx prettier . --check",
    "prettier:fix": "npx prettier . --write --log-level=warn",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage test/*.js",
    "test:coverage:lcov": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.js",
    "versions": "npx npm-dep-mgr check",
    "versions:fix": "npx npm-dep-mgr update"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haraka/haraka-plugin-helo.checks.git"
  },
  "keywords": [
    "haraka-plugin",
    "helo.checks"
  ],
  "author": "Haraka Team <haraka.team@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/haraka/haraka-plugin-helo.checks/issues"
  },
  "homepage": "https://github.com/haraka/haraka-plugin-helo.checks#readme",
  "devDependencies": {
    "@haraka/eslint-config": "^2.0.4",
    "haraka-test-fixtures": "^1.5.1"
  },
  "dependencies": {
    "haraka-dsn": "^1.1.0",
    "haraka-net-utils": "^1.8.2",
    "haraka-tld": "^1.3.4",
    "haraka-utils": "^1.1.4"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false
  }
}
